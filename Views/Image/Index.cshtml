@{
    ViewData["Title"] = "Image Analysis";
}
<h2>Analyze an Image</h2>

<h7 >Hello and welcome to this very specific photo analyzer. Here you can add a link to a photo, 
    and see if it is a dog, a cat or a rat. Have fun!</h7>
<br/>
<br/>

<form asp-controller="Image" asp-action="AnalyzeImage" method="post">
    <div>
        <label>Enter an image URL:</label>
        <input type="text" name="imageUrl" />
    </div>
    <div>
        <input type="submit" value="Analyze" />
    </div>
</form>

@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
{
    <div style="color: red;">
        @ViewBag.ErrorMessage
    </div>
}
